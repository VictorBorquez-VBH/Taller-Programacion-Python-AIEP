<?xml version="1.0" encoding="UTF-8"?><XMI xmlns:UML="href://org.omg/UML/1.3" xmi.version="1.1">
    <XMI.header>
        <XMI.documentation>
            <XMI.exporter>PlantUML</XMI.exporter>
            <XMI.exporterVersion>1.2024.3</XMI.exporterVersion>
        </XMI.documentation>
        <XMI.metamodel xmi.name="UML" xmi.version="1.4"/>
    </XMI.header>
    <XMI.content>
        <UML:Model name="PlantUML" xmi.id="model1">
            <UML:Namespace.ownedElement>
                <UML:Class name="Alumno" xmi.id="cl0002">
                    <UML:Classifier.feature>
                        <UML:Attribute name="id" visibility="private" xmi.id="att5"/>
                        <UML:Attribute name="nombre" visibility="private" xmi.id="att6"/>
                    </UML:Classifier.feature>
                </UML:Class>
                <UML:Class name="Curso" xmi.id="cl0003">
                    <UML:Classifier.feature>
                        <UML:Attribute name="codigo" visibility="private" xmi.id="att7"/>
                        <UML:Attribute name="nombre" visibility="private" xmi.id="att8"/>
                    </UML:Classifier.feature>
                </UML:Class>
            </UML:Namespace.ownedElement>
        </UML:Model>
    </XMI.content>
</XMI>
